#!/usr/bin/env bash
# macOS：用 Homebrew 装开发工具；desktop 机器再加桌面这一套（yabai + skhd + sketchybar）。
[[ $(uname -s) == Darwin ]] || exit 0
set -euo pipefail
cfg=${XDG_CONFIG_HOME:-$HOME/.config}/dev-env.local
[[ -f $cfg ]] && source "$cfg"
DEV_PROFILE=${DEV_PROFILE:-desktop}

brew bundle --file=- <<'BREW'
brew "git"
brew "neovim"
brew "tmux"
brew "fzf"
brew "ripgrep"
brew "tree-sitter"
brew "jq"
BREW

[[ $DEV_PROFILE == desktop ]] || exit 0
brew bundle --file=- <<'BREW'
tap "koekeishiya/formulae"
brew "yabai"
brew "skhd"
tap "FelixKratz/formulae"
brew "sketchybar"
brew "choose-gui"
brew "displayplacer"
cask "kitty"
BREW
