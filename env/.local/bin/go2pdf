#!/bin/bash
OUTPUT="code_$(date +%Y%m%d_%H%M).pdf"
echo "📝 开始收集 Go 和 GoHTML 文件..."
# 创建 Markdown 头部
cat > /tmp/code.md << 'HEADER'
---
title: 代码审查
CJKmainfont: PingFang SC
geometry: margin=2cm
---
HEADER
# 找到所有 Go 文件
echo "🔍 扫描项目目录..."
find . \( -name "*.go" -o -name "*.gohtml" \) -not -path "*/vendor/*" -not -path "*/.git/*" | sort > /tmp/gofiles.txt
FILE_COUNT=$(wc -l < /tmp/gofiles.txt | tr -d ' ')
if [ "$FILE_COUNT" -eq 0 ]; then
  echo "❌ 没有找到 Go 或 GoHTML 文件"
  exit 1
fi
echo "✅ 找到 $FILE_COUNT 个文件"
echo "📝 正在生成 Markdown (请稍候)..."
# 逐个处理文件
CURRENT=0
while IFS= read -r file; do
  CURRENT=$((CURRENT + 1))
  
  # 每 5 个显示一次进度
  if [ $((CURRENT % 5)) -eq 0 ]; then
    echo "   处理中... $CURRENT/$FILE_COUNT"
  fi
  
  # 根据文件扩展名决定语法高亮
  if [[ "$file" == *.gohtml ]]; then
    LANG="html"
  else
    LANG="go"
  fi
  
  cat >> /tmp/code.md << FILEMARK
# \`$file\`
\`\`\`$LANG
FILEMARK
  
  cat "$file" >> /tmp/code.md
  
  cat >> /tmp/code.md << ENDMARK
\`\`\`

ENDMARK
done < /tmp/gofiles.txt
echo "✅ Markdown 生成完成"
echo ""
echo "🔄 转换为 PDF (这可能需要 10-30 秒)..."
# 直接运行,不用后台
pandoc /tmp/code.md \
  -o "$OUTPUT" \
  --pdf-engine=xelatex \
  --highlight-style=tango
if [ -f "$OUTPUT" ]; then
  FILE_SIZE=$(du -h "$OUTPUT" | cut -f1)
  echo ""
  echo "✅ 成功! $OUTPUT ($FILE_SIZE)"
  rm -f /tmp/gofiles.txt
  open "$OUTPUT"
else
  echo "❌ 失败,检查 Markdown:"
  ls -lh /tmp/code.md
fi
